<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Container image for `dotnet publish -c Release /t:PublishContainer` (see deploy/README.md).
         The base image is Microsoft's ASP.NET Core runtime image; the app runs as a non-root user
         and listens on port 8080. -->
    <ContainerRepository>apihost</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" />
    <PackageReference Include="WolverineFx.SignalR" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
<!--#if (IsMarten) -->
    <PackageReference Include="Marten" />
    <PackageReference Include="Marten.AspNetCore" />
    <PackageReference Include="WolverineFx.Marten" />
<!--#endif -->
<!--#if (IsEfCore) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <!-- EF Core Design 11 needs Roslyn 5.9, but WolverineFx.RuntimeCompilation pulls the Roslyn 5.0
         metapackages (which pin their VB/Scripting parts to exactly 5.0). Lift them to 5.9 to avoid NU1608.
         Remove once dynamic codegen is dropped or Wolverine ships against Roslyn 5.9+. -->
    <PackageReference Include="Microsoft.CodeAnalysis" />
    <PackageReference Include="Microsoft.CodeAnalysis.Scripting" />
<!--#endif -->
<!--#if (Identity && IsMarten) -->
    <PackageReference Include="Marten.AspNetIdentity" />
<!--#endif -->
<!--#if (Identity) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
<!--#endif -->
<!--#if (Identity && IsEfCore) -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
<!--#endif -->
  </ItemGroup>

  <!--
    Pre-generated Wolverine code for production (TypeLoadMode.Static in Program.cs).
    `dotnet publish` regenerates it with `codegen write` and compiles it in, so it always matches
    the handlers being published and is never committed (Internal/Generated is in .gitignore).
    Ordinary builds ignore the folder: Development generates the same code at runtime.
  -->
  <PropertyGroup>
    <WolverineGeneratedDir>$(MSBuildProjectDirectory)/Internal/Generated/</WolverineGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Internal/Generated/**" />
  </ItemGroup>

  <Target Name="GenerateWolverineCode" BeforeTargets="CoreCompile" Condition="'$(_IsPublishing)' == 'true'">
    <RemoveDir Directories="$(WolverineGeneratedDir)" />
    <!-- Development settings, so codegen needs no production secrets; the generated code is the same. -->
    <Exec Command="dotnet run --no-restore --no-launch-profile --configuration Debug -- codegen write"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="ASPNETCORE_ENVIRONMENT=Development;DOTNET_ENVIRONMENT=Development" />
    <ItemGroup>
      <Compile Include="Internal/Generated/**/*.cs" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ClientDir>$(MSBuildProjectDirectory)\..\Client\</ClientDir>
  </PropertyGroup>

  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm install" WorkingDirectory="$(ClientDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />

    <ItemGroup>
      <ClientDistFiles Include="$(ClientDir)dist\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
