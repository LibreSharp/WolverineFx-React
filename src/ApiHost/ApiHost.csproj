<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="WolverineFx" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Http" Version="6.65.1" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" Version="6.65.1" />
    <PackageReference Include="WolverineFx.SignalR" Version="6.65.1" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
<!--#if (IsMarten) -->
    <PackageReference Include="Marten" Version="9.63.0" />
    <PackageReference Include="Marten.AspNetCore" Version="9.63.0" />
    <PackageReference Include="WolverineFx.Marten" Version="6.65.1" />
<!--#endif -->
<!--#if (IsEfCore) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.65.1" />
    <!-- EF Core Design 11 needs Roslyn 5.9, but WolverineFx.RuntimeCompilation pulls the Roslyn 5.0
         metapackages (which pin their VB/Scripting parts to exactly 5.0). Lift them to 5.9 to avoid NU1608.
         Remove once dynamic codegen is dropped or Wolverine ships against Roslyn 5.9+. -->
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Scripting" Version="5.9.0" />
<!--#endif -->
<!--#if (Identity && IsMarten) -->
    <PackageReference Include="Marten.AspNetIdentity" Version="11.0.1" />
<!--#endif -->
<!--#if (Identity) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
<!--#endif -->
<!--#if (Identity && IsEfCore) -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="11.0.0" />
<!--#endif -->
  </ItemGroup>

  <!--
    Pre-generated Wolverine code for production (TypeLoadMode.Static in Program.cs).
    `dotnet publish` regenerates it with `codegen write` and compiles it in, so it always matches
    the handlers being published and is never committed (Internal/Generated is in .gitignore).
    Ordinary builds ignore the folder: Development generates the same code at runtime.
  -->
  <PropertyGroup>
    <WolverineGeneratedDir>$(MSBuildProjectDirectory)/Internal/Generated/</WolverineGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Internal/Generated/**" />
  </ItemGroup>

  <Target Name="GenerateWolverineCode" BeforeTargets="CoreCompile" Condition="'$(_IsPublishing)' == 'true'">
    <RemoveDir Directories="$(WolverineGeneratedDir)" />
    <!-- Development settings, so codegen needs no production secrets; the generated code is the same. -->
    <Exec Command="dotnet run --no-restore --no-launch-profile --configuration Debug -- codegen write"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="ASPNETCORE_ENVIRONMENT=Development;DOTNET_ENVIRONMENT=Development" />
    <ItemGroup>
      <Compile Include="Internal/Generated/**/*.cs" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ClientDir>$(MSBuildProjectDirectory)\..\Client\</ClientDir>
  </PropertyGroup>

  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm install" WorkingDirectory="$(ClientDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />

    <ItemGroup>
      <ClientDistFiles Include="$(ClientDir)dist\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
