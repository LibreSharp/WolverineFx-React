{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
//#if (Identity)
  ,
  "Jwt": {
    "SigningKey": "DEV_ONLY_SIGNING_KEY_DO_NOT_USE_IN_PRODUCTION_0123456789"
  },
  "DevelopmentUser": {
    "Email": "demo@example.com",
    "Password": "Demo123!"
  },
  "Accounts": {
    // The demo user is an admin, so the admin page (/admin) can be tried out.
    "AdminEmails": [ "demo@example.com" ]
  },
  "App": {
    "ClientUrl": "http://localhost:5173"
  },
  "Email": {
    // Mailpit, from docker-compose.yml: it catches every email; read them at http://localhost:8025.
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None",
      "From": "ApiHost <no-reply@localhost>"
    }
  }
//#endif
//#if (Saas)
  ,
  "Webhooks": {
    // Lets webhooks go to localhost (to try a receiver on your machine) and over plain HTTP.
    // Never in production: a webhook URL could then reach the server's own network.
    "AllowPrivateNetworks": true
  }
//#endif
}
