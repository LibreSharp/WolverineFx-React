<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="WolverineFx" Version="6.16.0" />
    <PackageReference Include="WolverineFx.Http" Version="6.16.0" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.16.0" />
<!--#if (IsMarten) -->
    <PackageReference Include="Marten" Version="9.12.0" />
    <PackageReference Include="Marten.AspNetCore" Version="9.12.0" />
    <PackageReference Include="WolverineFx.Marten" Version="6.16.0" />
<!--#endif -->
<!--#if (IsEfCore) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.16.0" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.16.0" />
<!--#endif -->
<!--#if (Identity && IsMarten) -->
    <PackageReference Include="Marten.AspNetIdentity" Version="9.0.26" />
<!--#endif -->
<!--#if (Identity) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
<!--#endif -->
<!--#if (Identity && IsEfCore) -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
<!--#endif -->
  </ItemGroup>

  <PropertyGroup>
    <ClientDir>$(MSBuildProjectDirectory)\..\Client\</ClientDir>
  </PropertyGroup>

  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm install" WorkingDirectory="$(ClientDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientDir)" />

    <ItemGroup>
      <ClientDistFiles Include="$(ClientDir)dist\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
