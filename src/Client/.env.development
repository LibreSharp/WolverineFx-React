# Loaded only by the Vite dev server (`npm run dev`), never by `npm run build`.
# Pre-fills the login form; keep in sync with "DevelopmentUser" in the API's
# appsettings.Development.json, which creates this user at startup in Development.
VITE_DEV_LOGIN_EMAIL=demo@example.com
VITE_DEV_LOGIN_PASSWORD=Demo123!
