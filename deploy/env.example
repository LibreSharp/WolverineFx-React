# Copy to .env next to docker-compose.yml and fill in. Keep .env out of version control.

# The domain your DNS points at this server; Caddy gets its HTTPS certificate.
DOMAIN=app.example.com

# Database password: a long random value, e.g. from `openssl rand -base64 32`.
POSTGRES_PASSWORD=

#if (Identity)
# Signs login tokens: a random value of at least 32 bytes, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=

# Your email: register with it (or confirm it) and you become an admin, with the /admin page.
ADMIN_EMAIL=
# false: only people an admin invites can create accounts.
ALLOW_REGISTRATION=true

# Optional "Continue with Google/GitHub". Register the callback URL with the provider:
# https://DOMAIN/api/auth/external/signin-google (or signin-github).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP server for account emails: confirmation, password reset (most email services offer SMTP).
# Without SMTP_HOST no emails are sent, and new users can't confirm their email to log in.
SMTP_HOST=
SMTP_PORT=587
# Auto (TLS when offered), StartTls, SslOnConnect (port 465) or None.
SMTP_SECURITY=Auto
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

#endif
# Optional: where to send traces, metrics and logs (any OpenTelemetry backend).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Optional: the image to run, if you push it to a registry instead of loading it locally.
# APP_IMAGE=ghcr.io/your-org/apihost:1.0.0
