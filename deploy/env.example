# Copy to .env next to docker-compose.yml and fill in. Keep .env out of version control.

# The domain your DNS points at this server; Caddy gets its HTTPS certificate.
DOMAIN=app.example.com

# Database password: a long random value, e.g. from `openssl rand -base64 32`.
POSTGRES_PASSWORD=

#if (Identity)
# Signs login tokens: a random value of at least 32 bytes, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=

# SMTP server for password reset emails (most email services offer SMTP). Without SMTP_HOST,
# no emails are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

#endif
# Optional: where to send traces, metrics and logs (any OpenTelemetry backend).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Optional: the image to run, if you push it to a registry instead of loading it locally.
# APP_IMAGE=ghcr.io/your-org/apihost:1.0.0
