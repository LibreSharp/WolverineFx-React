<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>WolverineFxReact.Templates</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>WolverineFx + React Template</Title>
    <Authors>WolverineFx-React</Authors>
    <Description>A dotnet new template pairing a WolverineFx backend with a React (Vite + TypeScript + Tailwind) frontend, with optional Marten/EF Core persistence and JWT-based Identity.</Description>
    <PackageTags>dotnet-new;templates;wolverine;wolverinefx;react;vite</PackageTags>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include=".template.config\**\*" />
    <Content Include="src\**\*"
             Exclude="src\**\bin\**;src\**\obj\**;src\**\node_modules\**;src\**\dist\**;src\**\*.user" />
    <Content Include="tests\**\*" />
    <Content Include="docker-compose.yml" />
    <Content Include="WolverineFxReact.slnx" />
  </ItemGroup>

</Project>
