<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>LibreSharp.Templates.WolverineFxReact</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>LibreSharp WolverineFx + React Template</Title>
    <Authors>LibreSharp</Authors>
    <Description>A dotnet new template pairing a WolverineFx backend with a React (Vite + TypeScript + Tailwind) frontend: HTTP endpoints, messaging with a transactional outbox, Marten event sourcing or EF Core, validation, SignalR realtime updates, and optional accounts with ASP.NET Core Identity: JWT, email confirmation, lockout, roles and an admin page, invitations, Google/GitHub sign-in and passkeys. Tested end to end, with deployment to a small server. Built entirely on free, open-source libraries. A community template from LibreSharp, not an official WolverineFx/JasperFx package.</Description>
    <PackageTags>dotnet-new;templates;wolverine;wolverinefx;marten;react;vite;signalr;identity;passkeys;libresharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://libresharp.github.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LibreSharp/WolverineFx-React</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- nuget/README.md is written for the nuget.org page; the repo README is for contributors. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <None Include="nuget/README.md" Pack="true" PackagePath="/" />
    <Content Include=".template.config\**\*" />
    <Content Include="src\**\*"
             Exclude="src\**\bin\**;src\**\obj\**;src\**\node_modules\**;src\**\dist\**;src\**\*.user" />
    <Content Include="tests\**\*"
             Exclude="tests\**\bin\**;tests\**\obj\**;tests\**\*.user;tests\**\node_modules\**;tests\**\test-results\**;tests\**\playwright-report\**" />
    <Content Include="docker-compose.yml" />
    <Content Include="deploy\**\*" />
    <Content Include="ApiHost.slnx" />
    <Content Include="Directory.Packages.props" />
    <Content Include=".editorconfig" />
    <Content Include="dependabot.app.yml" />
    <Content Include="AGENTS.app.md" />
    <Content Include="CLAUDE.app.md" />
    <!-- Root dotfiles for the generated app (EnableDefaultItems is off, so list them). -->
    <Content Include=".gitignore" />
    <!-- Becomes README.md in the generated app (see template.json); README.md here is the template's. -->
    <Content Include="README.app.md" />
    <!-- Becomes docs/ in the generated app (see template.json). -->
    <Content Include="docs.app\**\*" />
    <Content Include=".gitattributes" />
  </ItemGroup>

</Project>
