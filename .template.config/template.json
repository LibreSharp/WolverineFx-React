{
  "$schema": "http://json.schemastore.org/template",
  "author": "LibreSharp",
  "classifications": [ "Web", "React", "Wolverine" ],
  "name": "LibreSharp WolverineFx + React",
  "identity": "LibreSharp.Templates.WolverineFxReact",
  "shortName": "wolverine-react",
  "sourceName": "ApiHost",
  "preferNameDirectory": true,
  "symbols": {
    "Persistence": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "marten", "description": "Marten document DB / event sourcing over PostgreSQL" },
        { "choice": "efcore", "description": "Entity Framework Core over PostgreSQL" }
      ],
      "defaultValue": "marten",
      "description": "Which persistence technology to use"
    },
    "IsMarten": {
      "type": "computed",
      "value": "(Persistence == \"marten\")"
    },
    "IsEfCore": {
      "type": "computed",
      "value": "(Persistence == \"efcore\")"
    },
    "Auth": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "none", "description": "No accounts: everyone shares the same Todos" },
        { "choice": "identity", "description": "Accounts with ASP.NET Core Identity: JWT, email confirmation, roles and an admin page, Google/GitHub sign-in and passkeys" },
        { "choice": "saas", "description": "Accounts plus organisations: each user's data belongs to an organisation, with members, roles and invitations" }
      ],
      "defaultValue": "none",
      "description": "Accounts and organisations"
    },
    "Identity": {
      "type": "computed",
      "value": "(Auth == \"identity\" || Auth == \"saas\")"
    },
    "Saas": {
      "type": "computed",
      "value": "(Auth == \"saas\")"
    },
    "MartenFileSuffix": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": ".cs" },
      "fileRename": ".Marten.cs"
    },
    "EfCoreFileSuffix": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": ".cs" },
      "fileRename": ".EfCore.cs"
    },
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the test projects"
    }
  },
  "SpecialCustomOperations": {
    "**/env.example": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "#if" ],
            "else": [ "#else" ],
            "elseif": [ "#elseif" ],
            "endif": [ "#endif" ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    },
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "actionableIf": [ "<!--#if" ],
            "actionableElse": [ "#else", "<!--#else" ],
            "actionableElseif": [ "#elseif", "<!--#elseif" ],
            "endif": [ "#endif", "<!--#endif" ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  },
  "sources": [
    {
      "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/bin/**",
        "**/obj/**",
        "**/.vs/**",
        "**/.idea/**",
        "**/*.user",
        ".template.config/**",
        "ROADMAP.md",
        "docs/**",
        "scripts/**",
        "nuget/**",
        "README.md",
        "LibreSharp.Templates.WolverineFxReact.csproj",
        ".git/**",
        "LICENSE",
        ".claude/**",
        ".token-optimizer/**",
        ".github/**"
      ],
      "modifiers": [
        {
          "condition": "(true)",
          "rename": {
            "README.app.md": "README.md",
            "CLAUDE.app.md": "CLAUDE.md",
            "AGENTS.app.md": "AGENTS.md",
            "docs.app": "docs",
            "dependabot.app.yml": ".github/dependabot.yml"
          }
        },
        {
          "condition": "(!IsMarten)",
          "exclude": [ "**/*.Marten.cs", "src/ApiHost/Data/Marten/**", "src/ApiHost/Identity/Marten/**", "tests/ApiHost.Tests/TodoEventStreamTests.cs" ]
        },
        {
          "condition": "(!IsEfCore)",
          "exclude": [ "**/*.EfCore.cs", "src/ApiHost/Data/EfCore/**", "src/ApiHost/Identity/EfCore/**", "docs.app/how-to/add-a-migration.md" ]
        },
        {
          "condition": "(!Identity)",
          "exclude": [
            "src/ApiHost/Identity/**",
            "src/ApiHost/Features/Auth/**",
            "src/ApiHost/Features/Account/**",
            "src/ApiHost/Features/Admin/**",
            "src/ApiHost/Features/Todos/DeleteTodosOfDeletedAccountHandler.*.cs",
            "src/Client/src/features/auth/**",
            "src/Client/src/features/account/**",
            "src/Client/src/features/admin/**",
            "src/Client/src/lib/passkeys.ts",
            "src/Client/.env.development",
            "src/Client/src/App.WithIdentity.tsx",
            "src/Client/src/routes.WithIdentity.ts",
            "src/Client/src/pages.WithIdentity.ts",
            "src/Client/src/routes/confirm-email.tsx",
            "src/Client/src/routes/confirm-email-change.tsx",
            "src/Client/src/routes/accept-invitation.tsx",
            "src/Client/src/routes/external-login.tsx",
            "src/Client/src/routes/login.tsx",
            "src/Client/src/routes/register.tsx",
            "src/Client/src/routes/forgot-password.tsx",
            "src/Client/src/routes/reset-password.tsx",
            "src/Client/src/routes/settings.tsx",
            "src/Client/src/routes/admin.tsx",
            "src/Client/src/routes/guest-only.tsx",
            "src/Client/src/routes/require-auth.tsx",
            "src/Client/src/routes/require-admin.tsx",
            "src/ApiHost/ApiHost.WithIdentity.http",
            "tests/ApiHost.Tests/AuthEndpointsTests.cs",
            "tests/ApiHost.Tests/AccountEndpointsTests.cs",
            "tests/ApiHost.Tests/AccountLockoutTests.cs",
            "tests/ApiHost.Tests/AdminEndpointsTests.cs",
            "tests/ApiHost.Tests/ExternalLoginTests.cs",
            "tests/ApiHost.Tests/EndpointSecurityTests.cs",
            "docs.app/accounts.md",
            "docs.app/how-to/configure-email.md",
            "docs.app/how-to/set-up-external-sign-in.md",
            "docs.app/how-to/add-a-role.md",
            "docs.app/how-to/make-an-admin.md",
            "docs.app/how-to/rotate-the-signing-key.md",
            "tests/e2e/specs/accounts.spec.ts",
            "tests/e2e/specs/admin.spec.ts",
            "tests/e2e/specs/passkeys.spec.ts",
            "tests/ApiHost.Tests/PasskeyTests.cs",
            "tests/ApiHost.Tests/SoftwarePasskey.cs",
            "tests/ApiHost.Tests/AuthRateLimitingTests.cs",
            "tests/ApiHost.Tests/TodoAuthorizationTests.cs",
            "tests/ApiHost.Tests/ClientUrlTests.cs"
          ]
        },
        {
          "condition": "(Saas)",
          "exclude": [ "src/Client/src/App.WithIdentity.tsx", "src/Client/src/routes.WithIdentity.ts", "src/Client/src/pages.WithIdentity.ts" ],
          "rename": {
            "src/Client/src/App.Saas.tsx": "src/Client/src/App.tsx",
            "src/Client/src/routes.Saas.ts": "src/Client/src/routes.ts",
            "src/Client/src/pages.Saas.ts": "src/Client/src/pages.ts"
          }
        },
        {
          "condition": "(Identity && !Saas)",
          "rename": {
            "src/Client/src/App.WithIdentity.tsx": "src/Client/src/App.tsx",
            "src/Client/src/routes.WithIdentity.ts": "src/Client/src/routes.ts",
            "src/Client/src/pages.WithIdentity.ts": "src/Client/src/pages.ts"
          }
        },
        {
          "condition": "(Identity)",
          "exclude": [ "src/Client/src/App.tsx", "src/Client/src/routes.ts", "src/Client/src/pages.ts", "src/ApiHost/ApiHost.http", "tests/e2e/specs/todos.spec.ts" ],
          "rename": {
            "src/ApiHost/ApiHost.WithIdentity.http": "src/ApiHost/ApiHost.http"
          }
        },
        {
          "condition": "(!Saas)",
          "exclude": [ "src/ApiHost/Organisations/**", "src/ApiHost/Features/Organisations/**", "tests/ApiHost.Tests/OrganisationTests.cs", "src/Client/src/App.Saas.tsx", "src/Client/src/routes.Saas.ts", "src/Client/src/pages.Saas.ts", "src/Client/src/features/organisations/**", "src/Client/src/routes/organisation.tsx", "src/Client/src/routes/join.tsx", "tests/e2e/specs/organisations.spec.ts", "src/ApiHost/Data/EfCore/Migrations.WithSaas/**", "src/ApiHost/Features/Todos/DeleteTodosOfDeletedOrganisationHandler.*.cs" ]
        },
        {
          "condition": "(Saas)",
          "exclude": [ "src/ApiHost/Features/Todos/DeleteTodosOfDeletedAccountHandler.*.cs" ]
        },
        {
          "condition": "(!IncludeTests)",
          "exclude": [ "tests/**" ]
        },
        {
          "condition": "(IsEfCore && !Identity)",
          "exclude": [ "src/ApiHost/Data/EfCore/Migrations.WithIdentity/**" ],
          "rename": {
            "src/ApiHost/Data/EfCore/Migrations.NoIdentity/20260720161356_InitialCreate.cs": "src/ApiHost/Data/EfCore/Migrations/20260720161356_InitialCreate.cs",
            "src/ApiHost/Data/EfCore/Migrations.NoIdentity/20260720161356_InitialCreate.Designer.cs": "src/ApiHost/Data/EfCore/Migrations/20260720161356_InitialCreate.Designer.cs",
            "src/ApiHost/Data/EfCore/Migrations.NoIdentity/AppDbContextModelSnapshot.cs": "src/ApiHost/Data/EfCore/Migrations/AppDbContextModelSnapshot.cs"
          }
        },
        {
          "condition": "(!Saas)",
          "exclude": [ "src/ApiHost/Data/EfCore/Migrations.WithSaas/**" ]
        },
        {
          "condition": "(IsEfCore && Identity && !Saas)",
          "rename": {
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/AppDbContextModelSnapshot.cs": "src/ApiHost/Data/EfCore/Migrations/AppDbContextModelSnapshot.cs"
          }
        },
        {
          "condition": "(IsEfCore && Saas)",
          "exclude": [ "src/ApiHost/Data/EfCore/Migrations.WithIdentity/AppDbContextModelSnapshot.cs" ],
          "rename": {
            "src/ApiHost/Data/EfCore/Migrations.WithSaas/20261127074218_AddOrganisations.cs": "src/ApiHost/Data/EfCore/Migrations/20261127074218_AddOrganisations.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithSaas/20261127074218_AddOrganisations.Designer.cs": "src/ApiHost/Data/EfCore/Migrations/20261127074218_AddOrganisations.Designer.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithSaas/AppDbContextModelSnapshot.cs": "src/ApiHost/Data/EfCore/Migrations/AppDbContextModelSnapshot.cs"
          }
        },
        {
          "condition": "(IsEfCore && Identity)",
          "exclude": [ "src/ApiHost/Data/EfCore/Migrations.NoIdentity/**" ],
          "rename": {
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20261126130647_InitialCreate.cs": "src/ApiHost/Data/EfCore/Migrations/20261126130647_InitialCreate.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20261126130647_InitialCreate.Designer.cs": "src/ApiHost/Data/EfCore/Migrations/20261126130647_InitialCreate.Designer.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20261127034335_AddPasskeys.cs": "src/ApiHost/Data/EfCore/Migrations/20261127034335_AddPasskeys.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20261127034335_AddPasskeys.Designer.cs": "src/ApiHost/Data/EfCore/Migrations/20261127034335_AddPasskeys.Designer.cs"
          }
        }
      ]
    }
  ]
}
