{
  "$schema": "http://json.schemastore.org/template",
  "author": "LibreSharp",
  "classifications": [ "Web", "React", "Wolverine" ],
  "name": "LibreSharp WolverineFx + React",
  "identity": "LibreSharp.Templates.WolverineFxReact",
  "shortName": "wolverine-react",
  "sourceName": "ApiHost",
  "preferNameDirectory": true,
  "symbols": {
    "Persistence": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "marten", "description": "Marten document DB / event sourcing over PostgreSQL" },
        { "choice": "efcore", "description": "Entity Framework Core over PostgreSQL" }
      ],
      "defaultValue": "marten",
      "description": "Which persistence technology to use"
    },
    "IsMarten": {
      "type": "computed",
      "value": "(Persistence == \"marten\")"
    },
    "IsEfCore": {
      "type": "computed",
      "value": "(Persistence == \"efcore\")"
    },
    "Identity": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include JWT-based authentication (register/login/refresh/logout) using ASP.NET Core Identity"
    },
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the test projects"
    }
  },
  "SpecialCustomOperations": {
    "**/env.example": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "#if" ],
            "else": [ "#else" ],
            "elseif": [ "#elseif" ],
            "endif": [ "#endif" ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    },
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "actionableIf": [ "<!--#if" ],
            "actionableElse": [ "#else", "<!--#else" ],
            "actionableElseif": [ "#elseif", "<!--#elseif" ],
            "endif": [ "#endif", "<!--#endif" ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  },
  "sources": [
    {
      "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/bin/**",
        "**/obj/**",
        "**/.vs/**",
        "**/.idea/**",
        "**/*.user",
        ".template.config/**",
        "ROADMAP.md",
        "nuget/**",
        "README.md",
        "LibreSharp.Templates.WolverineFxReact.csproj",
        ".git/**",
        "LICENSE",
        ".claude/**",
        ".token-optimizer/**",
        ".github/**"
      ],
      "modifiers": [
        {
          "condition": "(true)",
          "rename": {
            "README.app.md": "README.md",
            "CLAUDE.app.md": "CLAUDE.md",
            "AGENTS.app.md": "AGENTS.md",
            "dependabot.app.yml": ".github/dependabot.yml"
          }
        },
        {
          "condition": "(!IsMarten)",
          "exclude": [ "src/ApiHost/Data/Marten/**", "src/ApiHost/Identity/Marten/**", "tests/ApiHost.Tests/TodoEventStreamTests.cs" ]
        },
        {
          "condition": "(!IsEfCore)",
          "exclude": [ "src/ApiHost/Data/EfCore/**", "src/ApiHost/Identity/EfCore/**" ]
        },
        {
          "condition": "(!Identity)",
          "exclude": [
            "src/ApiHost/Identity/**",
            "src/ApiHost/Features/Todos/DeleteTodosOfDeletedAccountHandler.cs",
            "src/Client/src/features/auth/**",
            "src/Client/src/features/account/**",
            "src/Client/src/features/admin/**",
            "src/Client/src/lib/passkeys.ts",
            "src/Client/.env.development",
            "src/Client/src/App.WithIdentity.tsx",
            "src/ApiHost/ApiHost.WithIdentity.http",
            "tests/ApiHost.Tests/AuthEndpointsTests.cs",
            "tests/ApiHost.Tests/AccountEndpointsTests.cs",
            "tests/ApiHost.Tests/AccountLockoutTests.cs",
            "tests/ApiHost.Tests/AdminEndpointsTests.cs",
            "tests/ApiHost.Tests/ExternalLoginTests.cs",
            "tests/ApiHost.Tests/EndpointSecurityTests.cs",
            "tests/e2e/specs/accounts.spec.ts",
            "tests/e2e/specs/admin.spec.ts",
            "tests/e2e/specs/passkeys.spec.ts",
            "tests/ApiHost.Tests/PasskeyTests.cs",
            "tests/ApiHost.Tests/SoftwarePasskey.cs",
            "tests/ApiHost.Tests/AuthRateLimitingTests.cs",
            "tests/ApiHost.Tests/TodoAuthorizationTests.cs"
          ]
        },
        {
          "condition": "(Identity)",
          "exclude": [ "src/Client/src/App.tsx", "src/ApiHost/ApiHost.http", "tests/e2e/specs/todos.spec.ts" ],
          "rename": {
            "src/Client/src/App.WithIdentity.tsx": "src/Client/src/App.tsx",
            "src/ApiHost/ApiHost.WithIdentity.http": "src/ApiHost/ApiHost.http"
          }
        },
        {
          "condition": "(!IncludeTests)",
          "exclude": [ "tests/**" ]
        },
        {
          "condition": "(IsEfCore && !Identity)",
          "exclude": [ "src/ApiHost/Data/EfCore/Migrations.WithIdentity/**" ],
          "rename": {
            "src/ApiHost/Data/EfCore/Migrations.NoIdentity/20260720161356_InitialCreate.cs": "src/ApiHost/Data/EfCore/Migrations/20260720161356_InitialCreate.cs",
            "src/ApiHost/Data/EfCore/Migrations.NoIdentity/20260720161356_InitialCreate.Designer.cs": "src/ApiHost/Data/EfCore/Migrations/20260720161356_InitialCreate.Designer.cs",
            "src/ApiHost/Data/EfCore/Migrations.NoIdentity/AppDbContextModelSnapshot.cs": "src/ApiHost/Data/EfCore/Migrations/AppDbContextModelSnapshot.cs"
          }
        },
        {
          "condition": "(IsEfCore && Identity)",
          "exclude": [ "src/ApiHost/Data/EfCore/Migrations.NoIdentity/**" ],
          "rename": {
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20261126130647_InitialCreate.cs": "src/ApiHost/Data/EfCore/Migrations/20261126130647_InitialCreate.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20261126130647_InitialCreate.Designer.cs": "src/ApiHost/Data/EfCore/Migrations/20261126130647_InitialCreate.Designer.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20261127034335_AddPasskeys.cs": "src/ApiHost/Data/EfCore/Migrations/20261127034335_AddPasskeys.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20261127034335_AddPasskeys.Designer.cs": "src/ApiHost/Data/EfCore/Migrations/20261127034335_AddPasskeys.Designer.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/AppDbContextModelSnapshot.cs": "src/ApiHost/Data/EfCore/Migrations/AppDbContextModelSnapshot.cs"
          }
        }
      ]
    }
  ]
}
