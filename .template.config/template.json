{
  "$schema": "http://json.schemastore.org/template",
  "author": "WolverineFx-React",
  "classifications": [ "Web", "React", "Wolverine" ],
  "name": "WolverineFx + React",
  "identity": "WolverineFx.React.Template",
  "shortName": "wolverine-react",
  "sourceName": "ApiHost",
  "preferNameDirectory": true,
  "symbols": {
    "Persistence": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "marten", "description": "Marten document DB / event sourcing over PostgreSQL" },
        { "choice": "efcore", "description": "Entity Framework Core over PostgreSQL" }
      ],
      "defaultValue": "marten",
      "description": "Which persistence technology to use"
    },
    "IsMarten": {
      "type": "computed",
      "value": "(Persistence == \"marten\")"
    },
    "IsEfCore": {
      "type": "computed",
      "value": "(Persistence == \"efcore\")"
    },
    "Identity": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include JWT-based authentication (register/login/refresh/logout) using ASP.NET Core Identity"
    },
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the test projects"
    }
  },
  "SpecialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "actionableIf": [ "<!--#if" ],
            "actionableElse": [ "#else", "<!--#else" ],
            "actionableElseif": [ "#elseif", "<!--#elseif" ],
            "endif": [ "#endif", "<!--#endif" ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  },
  "sources": [
    {
      "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/bin/**",
        "**/obj/**",
        "**/.vs/**",
        "**/.idea/**",
        "**/*.user",
        ".template.config/**",
        "SPEC.md",
        "README.md",
        "REVIEW.md",
        "WolverineFxReact.Templates.csproj",
        ".git/**",
        ".github/**"
      ],
      "modifiers": [
        {
          "condition": "(!IsMarten)",
          "exclude": [ "src/ApiHost/Data/Marten/**", "src/ApiHost/Identity/Marten/**" ]
        },
        {
          "condition": "(!IsEfCore)",
          "exclude": [ "src/ApiHost/Data/EfCore/**", "src/ApiHost/Identity/EfCore/**" ]
        },
        {
          "condition": "(!Identity)",
          "exclude": [
            "src/ApiHost/Identity/**",
            "src/Client/src/features/auth/**",
            "src/Client/src/App.WithIdentity.tsx",
            "tests/ApiHost.Tests/AuthEndpointsTests.cs",
            "tests/ApiHost.Tests/TodoAuthorizationTests.cs"
          ]
        },
        {
          "condition": "(Identity)",
          "exclude": [ "src/Client/src/App.tsx" ],
          "rename": { "src/Client/src/App.WithIdentity.tsx": "src/Client/src/App.tsx" }
        },
        {
          "condition": "(!IncludeTests)",
          "exclude": [ "tests/**" ]
        },
        {
          "condition": "(IsEfCore && !Identity)",
          "exclude": [ "src/ApiHost/Data/EfCore/Migrations.WithIdentity/**" ],
          "rename": {
            "src/ApiHost/Data/EfCore/Migrations.NoIdentity/20260720161356_InitialCreate.cs": "src/ApiHost/Data/EfCore/Migrations/20260720161356_InitialCreate.cs",
            "src/ApiHost/Data/EfCore/Migrations.NoIdentity/20260720161356_InitialCreate.Designer.cs": "src/ApiHost/Data/EfCore/Migrations/20260720161356_InitialCreate.Designer.cs",
            "src/ApiHost/Data/EfCore/Migrations.NoIdentity/AppDbContextModelSnapshot.cs": "src/ApiHost/Data/EfCore/Migrations/AppDbContextModelSnapshot.cs"
          }
        },
        {
          "condition": "(IsEfCore && Identity)",
          "exclude": [ "src/ApiHost/Data/EfCore/Migrations.NoIdentity/**" ],
          "rename": {
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20260929105523_InitialCreate.cs": "src/ApiHost/Data/EfCore/Migrations/20260929105523_InitialCreate.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/20260929105523_InitialCreate.Designer.cs": "src/ApiHost/Data/EfCore/Migrations/20260929105523_InitialCreate.Designer.cs",
            "src/ApiHost/Data/EfCore/Migrations.WithIdentity/AppDbContextModelSnapshot.cs": "src/ApiHost/Data/EfCore/Migrations/AppDbContextModelSnapshot.cs"
          }
        }
      ]
    }
  ]
}
